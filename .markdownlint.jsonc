{
  // Enable all rules by default
  "default": true,
  // MD007: Unordered list indentation (2 spaces)
  "MD007": {
    "indent": 2
  },
  // MD009: Trailing spaces (disallow line break spaces)
  "MD009": {
    "br_spaces": 0
  },
  // MD013: Line length (disabled by default in VS Code, useful to disable for prose)
  "MD013": false,
  // MD024: Multiple headings with the same content (allow under different parent headings)
  "MD024": {
    "siblings_only": true
  },
  // MD033: Inline HTML (allow specific tags like <br> or <img>)
  "MD033": {
    "allowed_elements": [
      "br",
      "img",
      "details",
      "summary"
    ]
  },
  // MD041: First line in file should be a top-level heading (disable if using YAML frontmatter)
  "MD041": false
}